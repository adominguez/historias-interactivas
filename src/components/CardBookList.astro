---
import CardBookLandscape from "./CardBookLandscape.astro"
import { type LittleStory } from "@types"

const { bookList = [], showFilter } = Astro.props
---
{
  showFilter && (
    <div>Elegir tipo</div>
  )
}
<div class="grid gap-6 z-20 sm:grid-cols-2 lg:grid-cols-3">
  {
    bookList.map(({ slug, title, resume, rating, rating_count: ratingCount }: LittleStory) => (
      <CardBookLandscape slug={slug} title={title} resume={resume} ratingCount={ratingCount} rating={rating} detailed />
    ))
  }
</div>