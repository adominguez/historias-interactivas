---
interface Props {
  href: string;
  variant?: 'solid' | 'outline';
  class?: string;
}

const { href, variant = 'solid', class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2 px-6 py-3 rounded-full font-display text-sm tracking-wide border transition-colors',
    variant === 'solid'
      ? 'bg-forest-800 text-gold-400 border-gold-600/60 hover:bg-forest-900'
      : 'bg-transparent text-parchment-100 border-parchment-100/60 hover:bg-parchment-100/10',
    className,
  ]}
>
  <slot />
</a>
