---
import CardBookLandscape from "@components/CardBookLandscape.astro";
import { AGES } from "@src/utils/characters";
import { type LittleStory } from "@types";

interface Props {
  contentByAge: Record<string, any>;
  stories: LittleStory[];
}

const { contentByAge, stories } = Astro.props;

const bands = ['3-4', '5-8', '9-12', '13-18', '18+']
  .map((age) => ({ age, stories: stories.filter((s) => s.age === age) }))
  .filter((band) => band.stories.length > 0);
---

{
  bands.map(({ age, stories: bandStories }) => (
    <section class="px-4">
      <div class="max-w-5xl mx-auto parchment-surface rounded-lg border border-gold-600/40 shadow-lg p-6 md:p-10 flex flex-col md:flex-row gap-8">
        <div class="md:w-1/3 flex-shrink-0">
          <span class:list={['inline-block px-3 py-1 rounded-full text-white text-xs font-semibold mb-3', AGES[age].color]}>
            {AGES[age].alias}
          </span>
          <h2 class="font-display text-ink text-2xl mb-2">{contentByAge[age].title}</h2>
          <p class="text-ink/70">{contentByAge[age].content}</p>
        </div>
        <div class="flex-1 grid gap-4 sm:grid-cols-2">
          {bandStories.map((story) => (
            <CardBookLandscape
              slug={story.slug}
              title={story.title}
              resume={story.resume}
              rating={story.rating}
              ratingCount={story.rating_count}
              detailed={bandStories.length <= 2}
            />
          ))}
        </div>
      </div>
    </section>
  ))
}
