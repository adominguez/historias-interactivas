---
import CardBookList from "@components/CardBookList.astro";
import { type LittleStory } from "@types";

interface Props {
  bookList: LittleStory[];
  title?: string;
  content?: string;
  class?: string;
  id?: string;
}
const { bookList, title, content, class: className, id = 'cuentos' } = Astro.props;

---

<section class:list={[
  "books-parchment px-4 py-8 relative overflow-hidden",
  className
  ]} id={id}>
  <img
    src="/decorative/corner-sprig-small.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute top-0 left-0 w-24 md:w-32 h-auto opacity-70"
  />
  <div class="flex flex-col gap-8 mx-auto max-w-7xl relative">
    <h2 class="font-display text-ink text-balance">{title || '¿Qué cuento quieres leer?'}</h2>
    {
      content && <p class="text-ink/70 text-balance">{content}</p>
    }
    <CardBookList bookList={bookList} />
  </div>
</section>

<style>
  .books-parchment {
    background-color: #F6EEDD;
    background-image: url('/decorative/bg-parchment-texture.png');
    background-repeat: repeat;
    background-size: 512px 512px;
  }
</style>
