---
import { type Option } from "@types";
import Button from "./Button.astro";
import { buildPathRecapImageUrl } from "@src/utils/socialStoryImage";

interface Props {
  options: Option[];
  slug: string;
  storyPath?: { text: string; slug: string }[];
  storyTitle?: string;
  imageVersion?: number | null;
}

const { options = [], slug, storyPath = [], storyTitle, imageVersion = null } = Astro.props as Props;

// El remate "Tu camino" solo tiene sentido si de verdad se ha recorrido
// algo -- un cuento cuya propia raíz ya es un final (sin ningún nodo
// visitado) no tiene camino que mostrar, así que se mantiene el "¡Fin!"
// de siempre sin más.
const recapImageUrl = options.length === 0 && storyPath.length > 0 && storyTitle
  ? buildPathRecapImageUrl({ slug, imageVersion, storyTitle, steps: storyPath })
  : null;
---

{
  options?.length > 0 && (
    <div class="flex items-center gap-3 justify-center mt-10 mb-6">
      <span class="text-gold-600">❦</span>
      <h2 class="option-title font-display text-gold-600 m-0">¿Qué camino eliges?</h2>
      <span class="text-gold-600">❦</span>
    </div>
  )
}
{
  options.length > 0 ?
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {options.map((option: Option, index: number) => (
      <a
        class="option-card flex flex-col items-center text-center gap-3 p-6 rounded-xl border-2 border-gold-600/70 bg-parchment-200/70 hover:bg-parchment-200 hover:border-gold-600 hover:-translate-y-0.5 transition-all"
        href={`/${slug}/${option.next}#contenido`}
      >
        <span class="option-number flex items-center justify-center w-11 h-11 rounded-full border-2 border-gold-600 bg-parchment-100 font-display text-lg text-gold-600 shadow-inner">{index + 1}</span>
        <span class="font-serif-story text-ink">{option.text}</span>
      </a>
    ))}
  </div>
  : (
    <div class="flex flex-col items-center gap-6 mt-8">
      <span class="option-end block">¡Fin!</span>
      {
        recapImageUrl && (
          <div class="path-recap flex flex-col items-center gap-3 text-center">
            <h2 class="font-display text-gold-600 m-0">Tu camino</h2>
            <ol class="path-recap-list flex flex-col gap-1 text-ink/80 font-serif-story">
              {storyPath.map((step) => (
                <li>{step.text}</li>
              ))}
            </ol>
            <a
              href={recapImageUrl}
              download={`${slug}-camino.png`}
              class="inline-flex items-center gap-2 mt-2 px-5 py-2.5 rounded-full font-display text-sm tracking-wide border border-gold-600/60 bg-forest-800 text-gold-400 hover:bg-forest-900 transition-colors"
            >
              🖼️ Descargar imagen de tu camino
            </a>
          </div>
        )
      }
      <Button href="/" variant="solid">Volver al inicio</Button>
    </div>
  )
}

<style>
  .option-title {
    font-size: clamp(1.5em,4vw + .5em,2.5em);
  }
  /* Segunda línea fina hacia dentro del borde (efecto de marco "grabado"
     del mockup, sin imagen) combinada con una sombra de profundidad -- en
     un solo box-shadow para no competir con las utilidades de Tailwind. */
  .option-card {
    box-shadow: inset 0 0 0 4px rgba(201, 162, 39, 0.15), 0 2px 6px rgba(0, 0, 0, 0.15);
  }
  .option-card:hover {
    box-shadow: inset 0 0 0 4px rgba(201, 162, 39, 0.15), 0 8px 16px rgba(0, 0, 0, 0.25);
  }
  .option-end {
    font-family: 'Playfair Display Variable', serif;
    font-size: clamp(2em,4vw + .5em,3em);
    font-weight: 700;
    color: var(--accent);
  }
  .path-recap {
    max-width: 32rem;
  }
  .path-recap-list {
    list-style: decimal;
    list-style-position: inside;
    text-align: left;
  }
  .path-recap-list li::marker {
    color: #C9A227;
    font-weight: 700;
  }
</style>