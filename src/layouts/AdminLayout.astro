---
import '../styles/admin.css';
import { ADMIN_TOOLS } from '@data/adminTools';

// Envoltorio de todas las páginas de /admin: cabecera con navegación,
// título de la página y el ancho de contenido. A propósito NO usa BaseHead
// (y por tanto no carga global.css ni Tailwind): el admin tiene su propia
// hoja de estilos, src/styles/admin.css, sin nada de la web pública que
// pelearse. Todo /admin está detrás de Basic Auth (ver middleware.ts) y va
// con noindex por si acaso.
interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Admin</title>
  </head>
  <body>
    <header class="admin-top">
      <div class="admin-top-inner">
        <a class="admin-brand" href="/admin"><span aria-hidden="true">🌳</span> Admin</a>
        <nav class="admin-nav" aria-label="Herramientas">
          {ADMIN_TOOLS.map(({ href, navLabel, icon }) => (
            <a href={href} aria-current={current === href ? 'page' : undefined}>
              <span aria-hidden="true">{icon}</span> {navLabel}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main class="admin-main" style={wide ? 'max-width: 1180px;' : 'max-width: 820px;'}>
      <div class="page-head">
        <h1>{title}</h1>
        {description && <p class="lead">{description}</p>}
      </div>
      <slot />
    </main>
  </body>
</html>
