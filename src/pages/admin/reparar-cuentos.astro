---
import AdminLayout from "@layouts/AdminLayout.astro";
import RepairStoriesPanel from "@components/RepairStoriesPanel";
import CoherenceCheckGrid from "@components/CoherenceCheckGrid";
import { getLittleStoriesList } from "@src/turso";

export const prerender = false;

const rows = await getLittleStoriesList();
const stories = rows
  .map((row) => ({ slug: row.slug as string, title: row.title as string, age: row.age as string }))
  .sort((a, b) => a.title.localeCompare(b.title, "es"));
---

<AdminLayout title={"Reparar cuentos"} description={"Analiza todos los cuentos publicados en busca de problemas de estructura (grafo roto) y de contenido (diálogo mal formateado, palabras inválidas), y repara los de contenido con IA."} wide>
  <RepairStoriesPanel client:load />

  <section class="section">
    <h2>Coherencia narrativa y de reparto</h2>
    <p class="section-note">Comprobación semántica (con IA, no determinista) de si un cuento tiene sentido de principio a fin y si su reparto de personajes encaja temáticamente. A diferencia del análisis de arriba, no es gratis ni automática: se lanza cuento a cuento.</p>
    <CoherenceCheckGrid stories={stories} client:load />
  </section>
</AdminLayout>
