---
import AdminLayout from "@layouts/AdminLayout.astro";
import RegenerateStoryGrid from "@components/RegenerateStoryGrid";
import { getLittleStoriesList } from "@src/turso";
import { PUBLIC_CLOUDINARY_CLOUD_NAME } from "astro:env/server";

export const prerender = false;

const rows = await getLittleStoriesList();
const stories = rows
  .map((row) => ({ id: row.id as number, slug: row.slug as string, title: row.title as string, age: row.age as string, imageVersion: row.image_version as number | null }))
  .sort((a, b) => a.title.localeCompare(b.title, "es"));
---

<AdminLayout title={"Regenerar cuento completo"} description={"Sustituye TODO el contenido de un cuento (título, texto, grafo, personajes) por uno nuevo de la misma categoría y edad."} wide>
  <div class="card danger-zone" style="margin-bottom: 1.5rem;">
    <strong>⚠️ No tiene vuelta atrás.</strong>
    <p class="small" style="margin-bottom: 0;">Pensado para cuentos con la estructura rota que "Reparar cuentos" no puede arreglar escena a escena. La URL se mantiene si el título nuevo genera el mismo slug; si cambia, queda una redirección automática desde la antigua.</p>
  </div>

  <RegenerateStoryGrid stories={stories} cloudName={PUBLIC_CLOUDINARY_CLOUD_NAME} client:load />
</AdminLayout>
