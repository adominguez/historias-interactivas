---
import AdminLayout from "@layouts/AdminLayout.astro";
import DeleteStoryGrid from "@components/DeleteStoryGrid";
import { getLittleStoriesList } from "@src/turso";
import { PUBLIC_CLOUDINARY_CLOUD_NAME } from "astro:env/server";

export const prerender = false;

const rows = await getLittleStoriesList();
const stories = rows
  .map((row) => ({ id: row.id as number, slug: row.slug as string, title: row.title as string, age: row.age as string, imageVersion: row.image_version as number | null }))
  .sort((a, b) => a.title.localeCompare(b.title, "es"));
---

<AdminLayout title={"Eliminar cuento"} description={"Borra un cuento, todos sus nodos y su imagen de Cloudinary."} wide>
  <div class="card danger-zone" style="margin-bottom: 1.5rem;">
    <strong>⚠️ No tiene vuelta atrás.</strong>
    <p class="small" style="margin-bottom: 0;">Si la URL ya está indexada en Google, piensa antes si "Regenerar cuento completo" no es mejor opción: mantiene la URL o deja una redirección.</p>
  </div>

  <DeleteStoryGrid stories={stories} cloudName={PUBLIC_CLOUDINARY_CLOUD_NAME} client:load />
</AdminLayout>
