---
import AdminLayout from '@layouts/AdminLayout.astro';
import { ADMIN_TOOLS } from '@data/adminTools';
import { getLittleStoriesList } from '@src/turso';
import { getSocialPostsWithMetrics } from '@src/turso';

export const prerender = false;

// Un par de cifras para que la portada diga algo del estado del sitio, no
// solo enlaces: cuántos cuentos hay y si las redes han publicado hoy.
const now = new Date();
const today = now.toISOString().slice(0, 10);
const [stories, todayPosts] = await Promise.all([
  getLittleStoriesList(),
  getSocialPostsWithMetrics(`${today} 00:00:00`),
]);
const publishedToday = todayPosts.filter((post) => post.status === 'success').length;
const failedToday = todayPosts.filter((post) => post.status !== 'success').length;
const lastStory = [...stories].sort((a, b) => String(b.created_at).localeCompare(String(a.created_at)))[0];
---

<AdminLayout title="Admin" description="Herramientas internas para gestionar los cuentos y las redes sociales de El Árbol de las Historias." wide>
  <div class="grid" style="margin-bottom: 2rem;">
    <div class="card">
      <div class="tile-label">Cuentos publicados</div>
      <div class="tile-value">{stories.length}</div>
      <div class="tile-note">El último: {lastStory?.title}</div>
    </div>
    <div class="card">
      <div class="tile-label">Publicaciones en redes hoy</div>
      <div class="tile-value">{publishedToday} <span style="font-size: 1rem; font-weight: 400;">de 4</span></div>
      <div class="tile-note">
        {failedToday > 0
          ? <span class="badge badge-bad">❌ {failedToday} con fallo</span>
          : publishedToday === 4
            ? <span class="badge badge-ok">✅ Todo publicado</span>
            : <span class="badge badge-neutral">🕒 Quedan por salir</span>}
        <a href="/admin/redes-sociales" style="margin-left: 0.4rem;">ver detalle</a>
      </div>
    </div>
  </div>

  <h2>Herramientas</h2>
  <div class="grid">
    {ADMIN_TOOLS.map(({ href, title, description, icon }) => (
      <a href={href} class="card card-link">
        <strong><span aria-hidden="true">{icon}</span> {title}</strong>
        <p>{description}</p>
      </a>
    ))}
  </div>

  <p class="small muted" style="margin-top: 2rem;">
    Todo lo de aquí está protegido con usuario y contraseña y marcado como <code>noindex</code>: no aparece en Google.
  </p>
</AdminLayout>
