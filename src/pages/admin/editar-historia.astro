---
import BaseHead from '@components/BaseHead.astro';
import EditStoryForm from '@components/EditStoryForm';
import { getLittleStoriesList } from '@src/turso';

export const prerender = false;

const rows = await getLittleStoriesList();
const stories = rows
  .map((row) => ({ slug: row.slug as string, title: row.title as string, age: row.age as string }))
  .sort((a, b) => a.title.localeCompare(b.title, 'es'));
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title="Editar cuento (interno)" description="Herramienta interna para corregir a mano el texto de un cuento ya publicado." />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main style="max-width: 720px; margin: 4rem auto; padding: 0 1rem; font-family: system-ui, sans-serif;">
      <h1>Editar cuento</h1>
      <p>Busca un cuento, elige la escena inicial o cualquiera de sus nodos, y corrige el título o el texto a mano. Se guarda directamente, sin IA de por medio.</p>
      <EditStoryForm stories={stories} client:load />
    </main>
  </body>
</html>
