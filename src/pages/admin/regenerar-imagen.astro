---
import BaseHead from '@components/BaseHead.astro';
import RegenerateImagesGrid from '@components/RegenerateImagesGrid';
import { getLittleStoriesList } from '@src/turso';
import { PUBLIC_CLOUDINARY_CLOUD_NAME } from 'astro:env/server';

export const prerender = false;

const rows = await getLittleStoriesList();
const stories = rows
  .map((row) => ({ slug: row.slug as string, title: row.title as string, age: row.age as string, imageVersion: row.image_version as number | null }))
  .sort((a, b) => a.title.localeCompare(b.title, 'es'));
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title="Regenerar imágenes (interno)" description="Herramienta interna para revisar de un vistazo y regenerar las imágenes de portada de los cuentos." />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main style="max-width: 1100px; margin: 4rem auto; padding: 0 1rem; font-family: system-ui, sans-serif;">
      <h1>Regenerar imágenes</h1>
      <p>Repasa las portadas de todos los cuentos y regenera solo las que no encajen (sin tocar el texto ni el grafo). Cada regeneración puede tardar 1-2 minutos.</p>
      <RegenerateImagesGrid stories={stories} cloudName={PUBLIC_CLOUDINARY_CLOUD_NAME} client:load />
    </main>
  </body>
</html>
