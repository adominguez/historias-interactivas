---
import Layout from "@layouts/LayoutStory.astro";
import InlineEditableContent from "@components/InlineEditableContent";
import { getStoryBySlug, getRelatedStoriesBySlug, getRedirectTargetSlug, getStoryOptions } from "@src/turso";
import { type Story } from "@types";
import { generalCategories } from "@src/data/categories";
import { isAuthorized } from "@src/utils/auth";
export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return new Response(null, {
    status: 404,
    statusText: "Not found",
  });
}

const storyResponse = await getStoryBySlug(slug);

if (!storyResponse.length) {
  // El cuento pudo regenerarse con un slug nuevo (ver regenerateStory en
  // create-story.ts): antes de dar un 404 comprobamos si hay una
  // redirección permanente registrada para este slug antiguo.
  const targetSlug = await getRedirectTargetSlug(slug);
  if (targetSlug) {
    return Astro.redirect(`/${targetSlug}`, 301);
  }

  return new Response(null, {
    status: 404,
    statusText: "Not found",
  });
}
const storyData = storyResponse[0] as any;
if (!storyData) {
  return new Response(null, {
    status: 404,
    statusText: "Not found",
  });
}

const storyOptions = await getStoryOptions(storyData.id);

const story = {
  id: storyData.id,
  slug: storyData.slug,
  text: storyData.text,
  options: storyOptions,
  title: storyData.title,
  description: storyData.description,
  rating: storyData.rating,
  ratingCount: storyData.rating_count,
  categories: storyData.categories,
  created: storyData.created_at,
  age: storyData.age,
} as unknown as Story;

const date = new Date(storyData.created_at).toISOString().split('T')[0];
const modifiedDate = new Date(storyData.updated_at || storyData.created_at).toISOString().split('T')[0];

const parsedCategory = JSON.parse(story.categories)[0];
const matchedCategory = generalCategories.find((cat) => cat.name === parsedCategory) || generalCategories[0];
const category = {
  title: matchedCategory.title,
  slug: matchedCategory.slug,
};
const relatedStories = await getRelatedStoriesBySlug(story.slug);

const title = `${story.title}`;
const isAdmin = isAuthorized(Astro.request);
---

<Layout title={title} description={story.description} slug={story.slug} options={story.options} optionSlug={story.slug} relatedStories={relatedStories} rating={story.rating} ratingCount={story.ratingCount} ratingSlug={story.slug} category={category} created={date} modified={modifiedDate} age={story.age} imageVersion={storyData.image_version} isAdmin={isAdmin}>
  {isAdmin ? (
    <InlineEditableContent client:load storySlug={story.slug} target="story" initialTitle={story.title} initialText={story.text} />
  ) : (
    <div set:html={story.text} />
  )}
</Layout>
